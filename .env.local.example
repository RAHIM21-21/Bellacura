# Copy this file to .env.local and fill in your keys

# CodFacile API
CODFACILE_API_KEY=your_codfacile_api_key_here

# Stripe (for online card payments)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Site URL
NEXT_PUBLIC_SITE_URL=https://bellacura.it

# Email (optional - for order confirmations)
RESEND_API_KEY=re_...
